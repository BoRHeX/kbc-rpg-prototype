          "required": [
            "id",
            "mode",
            "phase",
            "clocks",
            "night",
            "chapter",
            "clears",
            "finale",
            "encounters",
            "rng",
            "player",
            "lives",
            "lifeLosses",
            "squad",
            "inventory",
            "fishing",
            "city",
            "wildcard",
            "actors",
            "systems"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
