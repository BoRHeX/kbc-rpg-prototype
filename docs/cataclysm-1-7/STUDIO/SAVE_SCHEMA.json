        "role": {
          "enum": [
            "shooter",
            "healer",
            "tank",
            "brawler",
            "sniper",
            "engineer",
            "trapper",
            "bard",
            "angler",
            "scout",
            "alchemist",
            "salvager",
            "saboteur",
            "stormcaller",
            "courier",
            "hexcat",
            "mecha"
