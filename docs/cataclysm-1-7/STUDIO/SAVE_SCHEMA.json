{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "gameVersion": {
      "const": "1.7"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$"
