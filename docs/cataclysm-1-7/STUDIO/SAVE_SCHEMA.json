        "originY",
        "originHp",
        "age",
        "committed",
        "ordinal",
        "bait",
        "outcome",
        "until",
        "bite"
      ],
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9:_-]{1,96}$"
        },
        "night": {
          "const": 1000
        },
        "clears": {
          "const": [
            1,
