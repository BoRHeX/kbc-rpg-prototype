              "type": "object",
              "description": "Capture discovered/open flags, per-district kill and guardian states, warranty, mutable gates, optional active city encounter, event clocks and relay. Derive immutable geometry."
            },
            "wildcard": {
              "type": "object",
              "description": "Capture phase, layout, dwell/stamps, lore, one-time pressure/reward/result, gust and fade timers, pulse data, counters and expiry."
