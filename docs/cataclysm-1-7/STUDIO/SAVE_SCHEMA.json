          ]
        },
        "runs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "campaignBest": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endlessBest": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cityBySeed": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[0-9]{1,10}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "discovery": {
                "type": "array",
                "items": {
                  "type": "boolean"
                },
                "maxItems": 4,
                "uniqueItems": false,
                "minItems": 4
              },
              "warrantySpent": {
                "type": "boolean"
              }
            },
            "required": [
              "discovery",
              "warrantySpent"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "completion",
        "runs",
        "campaignBest",
        "endlessBest",
        "cityBySeed"
      ],
      "additionalProperties": false
